    "/tracer/trace/list_voice_calls/": {
      "get": {
        "operationId": "tracer_trace_list_voice_calls",
        "summary": "Voice calls",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "[]",
            "minLength": 1
          },
          {
            "name": "attribute_keys",
            "in": "query",
            "description": "JSON-encoded list of custom attribute keys to include as CSV columns. Comma-separated simple keys remain supported.",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "One-based numbered page. Pages whose required ordered work exceeds the finite read contract return HTTP 422 with code page_depth_exceeded; request an earlier page, use the additive continuation cursor, or narrow the time range.",
            "required": false,
            "type": "integer",
            "default": 1,
            "minimum": 1
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 30,
            "maximum": 500,
            "minimum": 1
          },
          {
            "name": "remove_simulation_calls",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque continuation token returned by the previous page. When supplied, do not also send the numbered-page parameter.",
            "required": false,
            "type": "string",
            "maxLength": 4096,
            "minLength": 1
          },
          {
            "name": "cursor_mode",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "allow_sampled",
            "in": "query",
            "description": "Omit for backward-compatible complete bounded pages, which may label count as a lower bound. Send false to require an exact total. Send true to opt in explicitly to lower-bound totals and, on the first page, a clearly labelled bounded partial result when the full ordered prefix cannot be proven inside the read budget.",
            "required": false,
            "type": "boolean"
          }
        ],
        "description": "\n\nPagination: page (1-based); page_size (page size); cursor (opaque continuation token); cursor_mode (enable cursor pagination)."
      }
    },
