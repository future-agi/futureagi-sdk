{
  "about": "One rule set for the public platform files, read by scripts/platform/scope-filter.mjs, scripts/platform/hygiene-scan.mjs and scripts/platform/hygiene_scan.py (which the Python gates import). A hit fails the build. This file is scanned like every other file and passes its own scan: a pattern that would match its own text is written with a one-character class, and internal names are listed only as sha256 under \"names\" (see scripts/platform/hygiene-names.mjs). \"patterns\" are regular expressions; local paths are matched by their operating-system roots, which name no one. \"wording\" lists patches the scope filter applies to kept descriptions that would otherwise fail a rule: each pattern must match exactly once. \"exemptions\" lets one line (by the sha256 of its stripped text) of one file hit the listed rules; a malformed exemption, or one that matches no line of a scanned file, is itself a hit.",
  "extensions": {
    "operation": [
      "x-omega-sdk",
      "x-omega-idempotent",
      "x-omega-idempotency",
      "x-omega-not-found-on-retry-means-applied",
      "x-omega-stream",
      "x-omega-pagination",
      "x-omega-rate-class",
      "x-omega-timeout-class",
      "x-omega-body-class",
      "x-omega-min-role"
    ],
    "schema": [
      "x-omega-secret"
    ],
    "subkeys": {
      "x-omega-idempotency": [
        "durable",
        "keyRequired",
        "replayOmits"
      ]
    }
  },
  "nameMaps": [
    "properties",
    "headers",
    "schemas",
    "responses",
    "parameters",
    "securitySchemes",
    "content",
    "examples",
    "variables",
    "mapping",
    "paths",
    "patternProperties",
    "$defs",
    "encoding"
  ],
  "forbiddenKeys": [
    "evidence"
  ],
  "patterns": [
    {
      "id": "consumer-revision",
      "paths": [
        "python/tests/evals/fixtures/census-fi-evals.json"
      ],
      "regex": "\"(?:commit|revision|consumer_head)\"\\s*:\\s*\"[0-9a-f]{40}\""
    },
    {
      "id": "volumes-path",
      "regex": "/Volumes/[A-Za-z0-9._-]"
    },
    {
      "id": "home-path",
      "regex": "(?:/Users/|/home/)[A-Za-z0-9._-]+"
    },
    {
      "id": "tmp-path",
      "regex": "/private/tmp(?=/)"
    },
    {
      "id": "internal-id",
      "regex": "\\b(?:SB|SBX|DS|CP|GW|EE|OM|PS|SDK|T[H]|DS[X]|W[0-9])-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*\\b"
    },
    {
      "id": "internal-review",
      "regex": "\\b(?:release[ ]manifest|cloud[ ]rig|[Tt]he[ ]rig\\b|[Tt]he[ ]plan\\b|day[-]one|forcing[ ]fixture|owner[ ]decision|owner[ ]question)"
    },
    {
      "id": "plan-reference",
      "regex": "\u00a7\\s*[0-9]|\\bask [a-z](?=[:;,)])"
    },
    {
      "id": "owner-question",
      "regex": "\\bQ[0-9]{1,2}\\b"
    },
    {
      "id": "source-ts-path",
      "regex": "[A-Za-z0-9_][\\w/.-]*\\.ts\\b",
      "skipExtensions": [
        ".ts",
        ".mts",
        ".cts",
        ".mjs",
        ".js",
        ".cjs",
        ".py",
        ".sh",
        ".md"
      ]
    },
    {
      "id": "ee-source-path",
      "regex": "(?:packages/(?:server|managed-runtime|console)|(?:^|[\\s\"'`(])workspace)/[\\w/.-]+\\.tsx?\\b"
    },
    {
      "id": "private-key",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "id": "aws-key",
      "regex": "AKIA[0-9A-Z]{16}"
    },
    {
      "id": "github-token",
      "regex": "gh[pousr]_[A-Za-z0-9]{30,}"
    },
    {
      "id": "slack-token",
      "regex": "xox[abpr]-[A-Za-z0-9-]{10,}"
    },
    {
      "id": "google-key",
      "regex": "AIza[0-9A-Za-z_-]{35}"
    },
    {
      "id": "openai-style-key",
      "regex": "sk-(?:or-|proj-|ant-)?[A-Za-z0-9_-]{24,}"
    }
  ],
  "names": {
    "about": "Internal names as the sha256 of their lower-case text, each mapped to the rule it fails. The plain list is kept outside this repository; node scripts/platform/hygiene-scan.mjs --names <file> checks the two agree, and --hash <rule id> <name> prints a new entry.",
