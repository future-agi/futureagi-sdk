    {
      "id": "platform.agents.deployments.rollback.unknown",
      "title": "Rolling an agent deployment back to a version that does not exist is a typed refusal",
      "sdk": {
        "family": "platform",
        "method": "agents.rollbackDeployment"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/workforce/agents/{id}/deployments/{id}/rollback"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "agent"
      ],
      "call": {
        "params": [
          "${res.agent}",
          "999"
        ],
        "body": {
          "expectedDeploymentVersion": 999,
          "expectedProcessId": "proc-conformance-missing"
        }
      },
      "expect": {
        "status": [
          400,
          404,
          409
        ],
        "codePresent": true
      }
    },
