{
  "schemaVersion": "sdk-conformance-cases/v1",
  "family": "platform",
  "about": "Agents: the roster, create, update, revisions, drafts, releases and rollbacks.",
  "cases": [
    {
      "id": "platform.workforce.get",
      "title": "Read the workforce (agents and teams)",
      "sdk": {
        "family": "platform",
        "method": "agents.roster"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/workforce"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "agents": "array"
        }
      }
    },
    {
      "id": "platform.agents.create",
      "title": "Create an agent",
      "sdk": {
        "family": "platform",
        "method": "agents.create"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/workforce/agents"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating"
      ],
      "call": {
        "body": {
          "name": "Conformance agent ${run.short}",
          "role": "Conformance",
          "purpose": "An SDK conformance fixture agent.",
          "responsibilities": [
            "Reply in one short sentence"
          ],
          "workMode": "on_demand",
          "connectorBindingIds": []
        }
      },
      "args": {
        "name": "Conformance agent ${run.short}",
        "role": "Conformance",
        "purpose": "An SDK conformance fixture agent.",
        "responsibilities": [
          "Reply in one short sentence"
        ],
        "workMode": "on_demand",
        "connectorBindingIds": []
      },
      "expect": {
        "status": 201,
        "contract": true,
        "fields": {
          "agent.id": "string"
        }
      },
      "capture": {
        "agent": "agent.id"
      },
      "cleanup": [
        {
          "op": {
            "method": "DELETE",
            "path": "/workspace/workforce/agents/{id}"
          },
          "params": {
            "id": "${cap.agent}"
          }
        }
      ]
    },
    {
      "id": "platform.agents.create.missing-fields",
      "title": "An agent without its required fields is a typed 400",
      "sdk": {
        "family": "platform",
        "method": "agents.create"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/workforce/agents"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "call": {
        "body": {
          "name": "half an agent"
        },
        "bodyInvalidOnPurpose": true
      },
      "expect": {
        "status": 400,
        "errorClass": "BadRequestError",
        "codePresent": true
      }
    },
    {
      "id": "platform.agents.get",
      "title": "Get one agent",
      "sdk": {
        "family": "platform",
        "method": "agents.get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/workforce/agents/{id}"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "agent"
      ],
      "call": {
        "params": {
          "id": "${res.agent}"
        }
      },
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "agent.id": {
            "equals": "${res.agent}"
          }
        }
      }
    },
    {
      "id": "platform.agents.get.cross-tenant",
      "title": "Org B's credential on org A's agent answers 404, every time",
      "sdk": {
        "family": "platform",
        "method": "agents.get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/workforce/agents/{id}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "agent"
      ],
      "call": {
        "params": {
          "id": "${res.agent}"
        }
      },
      "repeat": 20,
      "expect": {
        "status": [
          404,
          403
        ],
        "codePresent": true
      }
    },
