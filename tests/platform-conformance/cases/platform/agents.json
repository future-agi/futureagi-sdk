      "id": "platform.agents.delete",
      "title": "Delete an agent (admin)",
      "sdk": {
        "family": "platform",
        "method": "agents.retire"
      },
      "op": {
        "method": "DELETE",
        "path": "/workspace/workforce/agents/{id}"
      },
