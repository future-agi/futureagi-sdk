{
  "schemaVersion": "sdk-conformance-cases/v1",
  "family": "platform",
  "about": "Workspace secrets (the credential vault), read only: values never come back.",
  "cases": [
    {
      "id": "platform.credentials.list",
      "title": "List workspace credentials (names, never values)",
      "sdk": {
        "family": "platform",
        "method": "credentials.list"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/credentials"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "credentials": "array"
        }
      }
    },
    {
      "id": "platform.credentials.get",
      "title": "Get one credential's metadata",
      "sdk": {
        "family": "platform",
        "method": "credentials.get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/credentials/{id}"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "credential"
      ],
      "call": {
        "params": {
          "id": "${res.credential}"
        }
      },
      "expect": {
        "status": 200,
        "contract": true,
        "noLeak": [
          "conf-credential-value-${run.short}"
        ]
      }
    },
    {
      "id": "platform.credentials.bindings",
      "title": "List where a credential is bound",
      "sdk": {
        "family": "platform",
        "method": "credentials.bindings"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/credentials/{id}/bindings"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "credential"
      ],
      "call": {
        "params": {
          "id": "${res.credential}"
        }
      },
      "expect": {
        "status": 200,
        "contract": true
      }
    },
    {
      "id": "platform.credentials.get.cross-tenant",
      "title": "Org B cannot read org A's credential",
      "sdk": {
        "family": "platform",
        "method": "credentials.get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/credentials/{id}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "credential"
      ],
      "call": {
        "params": {
          "id": "${res.credential}"
        }
      },
      "repeat": 5,
      "expect": {
        "status": 404,
        "errorClass": "NotFoundError",
        "codePresent": true
      }
    }
  ]
}
