    {
      "id": "sandboxes.get.ok",
      "title": "Get one sandbox by id",
      "sdk": {
        "family": "sandboxes",
        "method": "getInfo"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/sandboxes/{sandbox}"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "sandbox"
      ],
      "call": {
        "params": {
          "sandbox": "${res.sandbox}"
        }
      },
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "sandbox.id": {
            "equals": "${res.sandbox}"
          }
        }
      }
    },
    {
      "id": "sandboxes.get.cross-tenant",
      "title": "Org B's credential on org A's sandbox id answers 404, every time",
      "sdk": {
        "family": "sandboxes",
        "method": "getInfo"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/sandboxes/{sandbox}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "sandbox"
      ],
      "call": {
        "params": {
          "sandbox": "${res.sandbox}"
        }
      },
      "repeat": 20,
      "expect": {
        "status": 404,
        "errorClass": "NotFoundError",
        "codePresent": true
      }
    },
    {
      "id": "sandboxes.get.forged-scope",
      "title": "Org B's key with org A's scope selectors cannot read org A's sandbox, every time",
      "sdk": {
        "family": "sandboxes",
        "method": "getInfo"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/sandboxes/{sandbox}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A",
        "scopeOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "sandbox"
      ],
      "call": {
        "params": {
          "sandbox": "${res.sandbox}"
        }
      },
      "repeat": 20,
      "expect": {
        "status": [
          401,
          403,
          404
        ]
      },
      "expectByMode": {
        "ee-key": {
          "status": 403,
          "code": "workspace_scope_denied",
          "errorClass": "PermissionDeniedError"
        }
      }
    },
    {
