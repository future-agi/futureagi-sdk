{
  "schemaVersion": "sdk-conformance-cases/v1",
  "family": "sandboxes",
  "about": "Sandbox lifecycle, settings and role floors.",
  "cases": [
    {
      "id": "sandboxes.list.ok",
      "title": "List the workspace's sandboxes",
      "sdk": {
        "family": "sandboxes",
        "method": "list"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/sandboxes"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "sandboxes": "array"
        }
      }
    },
    {
      "id": "sandboxes.create.ok",
      "title": "Create a sandbox; the answer names it and its state",
      "sdk": {
        "family": "sandboxes",
        "method": "create"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/sandboxes"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating"
      ],
      "call": {
        "body": {
          "name": "conf-create-${run.short}"
        }
      },
      "args": {
        "name": "conf-create-${run.short}"
      },
      "expect": {
        "status": 201,
        "contract": true,
        "fields": {
          "sandbox.id": "string",
          "sandbox.state": "string"
        }
      },
      "capture": {
        "sbx": "sandbox.id"
      },
      "cleanup": [
        {
          "op": {
            "method": "DELETE",
            "path": "/workspace/sandboxes/{sandbox}"
          },
          "params": {
            "sandbox": "${cap.sbx}"
          }
        }
      ]
    },
    {
      "id": "sandboxes.create.member",
