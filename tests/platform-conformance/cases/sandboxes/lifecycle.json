      }
    },
    {
      "id": "sandboxes.kill.cross-tenant",
      "title": "Org B cannot destroy org A's sandbox, and it is still there afterwards",
      "sdk": {
        "family": "sandboxes",
        "method": "kill"
      },
      "op": {
        "method": "DELETE",
        "path": "/workspace/sandboxes/{sandbox}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "sandbox"
      ],
      "call": {
        "params": {
          "sandbox": "${res.sandbox}"
        }
      },
      "repeat": 5,
      "expect": {
        "status": 404,
        "errorClass": "NotFoundError",
        "codePresent": true
      },
      "verify": [
        {
          "op": {
            "method": "GET",
            "path": "/workspace/sandboxes/{sandbox}"
          },
          "params": {
            "sandbox": "${res.sandbox}"
          },
          "expectStatus": 200
        }
      ]
    },
    {
      "id": "sandboxes.kill.ok",
      "title": "Destroy a sandbox",
      "sdk": {
        "family": "sandboxes",
        "method": "kill"
      },
      "op": {
        "method": "DELETE",
        "path": "/workspace/sandboxes/{sandbox}"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating",
        "slow"
      ],
      "setup": [
        {
          "op": {
            "method": "POST",
            "path": "/workspace/sandboxes"
          },
          "body": {
            "name": "conf-${run.short}"
          },
          "capture": {
            "sbx": "sandbox.id"
          },
          "expectStatus": 201,
          "waitFor": {
            "op": {
              "method": "GET",
              "path": "/workspace/sandboxes/{sandbox}"
            },
            "params": {
              "sandbox": "${cap.sbx}"
            },
            "field": "sandbox.state",
            "in": [
              "active"
            ],
            "timeoutMs": 240000
          }
        }
      ],
      "call": {
        "params": {
          "sandbox": "${cap.sbx}"
        }
      },
      "expect": {
        "status": 200,
        "contract": true
      },
      "verify": [
        {
          "op": {
            "method": "GET",
            "path": "/workspace/sandboxes/{sandbox}"
          },
          "params": {
            "sandbox": "${cap.sbx}"
          },
          "expectStatus": [
            404,
            200
          ]
        }
      ]
    },
    {
      "id": "sandboxes.kill.repeat-is-404",
      "title": "Destroying a destroyed sandbox is safe to repeat (200 again, or 404): a retried kill never fails",
      "sdk": {
        "family": "sandboxes",
        "method": "kill"
      },
      "op": {
        "method": "DELETE",
        "path": "/workspace/sandboxes/{sandbox}"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating",
        "slow"
      ],
      "setup": [
        {
          "op": {
            "method": "POST",
            "path": "/workspace/sandboxes"
          },
          "body": {
            "name": "conf-${run.short}"
          },
          "capture": {
            "sbx": "sandbox.id"
          },
          "expectStatus": 201,
          "waitFor": {
            "op": {
              "method": "GET",
              "path": "/workspace/sandboxes/{sandbox}"
            },
            "params": {
              "sandbox": "${cap.sbx}"
            },
            "field": "sandbox.state",
            "in": [
              "active"
            ],
            "timeoutMs": 240000
          }
        },
        {
          "op": {
            "method": "DELETE",
            "path": "/workspace/sandboxes/{sandbox}"
          },
          "params": {
            "sandbox": "${cap.sbx}"
          },
          "expectStatus": 200
        }
      ],
      "call": {
        "params": {
          "sandbox": "${cap.sbx}"
        }
      },
      "expect": {
        "status": [
          200,
          404
        ]
      }
    },
