{
  "schemaVersion": "sdk-conformance-cases/v1",
  "family": "runs",
  "about": "Runs (conversations): create, send (idempotent), cancel, interrupt, continue, retry, fork, rate, delete.",
  "cases": [
    {
      "id": "runs.create.ok",
      "title": "Start a run on an agent; the answer names the run and its first message",
      "sdk": {
        "family": "runs",
        "method": "create"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/conversations"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating"
      ],
      "needs": [
        "agent"
      ],
      "call": {
        "body": {
          "input": "conformance run ${run.short}",
          "agentId": "${own.agent}"
        }
      },
      "args": {
        "agentId": "${own.agent}",
        "input": "conformance run ${run.short}"
      },
      "expect": {
        "status": 201,
        "contract": true,
        "fields": {
          "conversation.id": "string",
          "firstMessage.id": "string"
        }
      },
      "capture": {
        "conv": "conversation.id"
      },
      "cleanup": [
        {
          "op": {
            "method": "DELETE",
            "path": "/workspace/conversations/{id}"
          },
          "params": {
            "id": "${cap.conv}"
          },
          "as": "caller"
        }
      ]
    },
    {
      "id": "runs.create.missing-input",
