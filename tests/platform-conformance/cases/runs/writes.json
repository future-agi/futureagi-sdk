    {
      "id": "runs.send.ok",
      "title": "Send a follow-up message with an idempotency key",
      "sdk": {
        "family": "runs",
        "method": "send"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/conversations/{id}/messages"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating"
      ],
      "setup": [
        {
          "op": {
            "method": "POST",
            "path": "/workspace/conversations"
          },
          "body": {
            "input": "conformance setup ${run.short}",
            "agentId": "${own.agent}"
          },
          "capture": {
            "conv": "conversation.id"
          },
          "expectStatus": 201,
          "as": "caller",
          "waitFor": {
            "op": {
              "method": "GET",
              "path": "/workspace/conversations/{id}"
            },
            "params": {
              "id": "${cap.conv}"
            },
            "field": "conversation.status",
            "in": [
              "done",
              "error",
              "waiting_approval",
              "canceled"
            ],
            "timeoutMs": 120000
          }
        }
      ],
      "call": {
        "params": {
          "id": "${cap.conv}"
        },
        "body": {
          "input": "second turn"
        }
      },
      "expect": {
        "status": [
          200,
          202
        ],
        "contract": true,
        "fields": {
          "message.id": "string",
          "duplicate": {
            "equals": false
          }
        }
      },
      "cleanup": [
        {
          "op": {
            "method": "DELETE",
            "path": "/workspace/conversations/{id}"
          },
          "params": {
            "id": "${cap.conv}"
          },
          "as": "caller"
        }
      ]
    },
    {
      "id": "runs.send.replay",
      "title": "The same idempotency key and body replays the first answer (duplicate: true)",
      "sdk": {
        "family": "runs",
        "method": "send"
      },
      "op": {
        "method": "POST",
        "path": "/workspace/conversations/{id}/messages"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "mutating"
      ],
      "setup": [
        {
          "op": {
            "method": "POST",
            "path": "/workspace/conversations"
          },
          "body": {
            "input": "conformance setup ${run.short}",
            "agentId": "${own.agent}"
          },
          "capture": {
            "conv": "conversation.id"
          },
          "expectStatus": 201,
          "as": "caller",
          "waitFor": {
            "op": {
              "method": "GET",
              "path": "/workspace/conversations/{id}"
            },
            "params": {
              "id": "${cap.conv}"
            },
            "field": "conversation.status",
            "in": [
              "done",
              "error",
              "waiting_approval",
              "canceled"
            ],
            "timeoutMs": 120000
          }
        },
        {
          "op": {
            "method": "POST",
            "path": "/workspace/conversations/{id}/messages"
          },
          "params": {
            "id": "${cap.conv}"
          },
          "body": {
            "input": "replayed turn"
          },
          "idempotencyKey": "conf-replay-${run.short}",
          "as": "caller",
          "capture": {
            "firstMessage": "message.id"
          }
        }
      ],
      "call": {
        "params": {
          "id": "${cap.conv}"
        },
        "body": {
          "input": "replayed turn"
        },
        "idempotencyKey": "conf-replay-${run.short}"
      },
      "expect": {
        "status": [
          200,
          202
        ],
        "fields": {
          "duplicate": {
            "equals": true
          },
          "message.id": {
            "equals": "${cap.firstMessage}"
          }
        }
      },
      "cleanup": [
        {
          "op": {
            "method": "DELETE",
            "path": "/workspace/conversations/{id}"
          },
          "params": {
            "id": "${cap.conv}"
          },
          "as": "caller"
        }
      ]
    },
