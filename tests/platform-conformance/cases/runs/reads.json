        }
      },
      "expect": {
        "status": 404,
        "errorClass": "NotFoundError",
        "codePresent": true
      }
    },
    {
      "id": "runs.events.replay",
      "title": "Read a finished run's durable events from the start to done",
      "sdk": {
        "family": "runs",
        "method": "events"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations/{id}/events"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "params": {
          "id": "${res.conversation}"
        },
        "stream": {
          "kind": "sse-get",
          "maxMs": 20000,
          "until": [
            "done"
          ]
        }
      },
      "expect": {
        "status": 200,
        "events": {
          "include": [
            "done"
          ],
          "minCount": 2
        }
      }
    },
    {
      "id": "runs.events.resume",
      "title": "Resume after a sequence with Last-Event-ID: nothing at or before it comes back",
      "sdk": {
        "family": "runs",
        "method": "events"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations/{id}/events"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "params": {
          "id": "${res.conversation}"
        },
        "headers": {
          "last-event-id": "1"
        },
        "stream": {
          "kind": "sse-get",
          "maxMs": 20000,
          "until": [
            "done"
          ]
        }
      },
      "expect": {
        "status": 200,
        "events": {
          "afterSeq": 1
        }
      }
    },
    {
      "id": "runs.events.poll",
      "title": "The long-poll transport answers JSON for edge callers",
      "sdk": {
        "family": "runs",
        "method": "events"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations/{id}/events"
