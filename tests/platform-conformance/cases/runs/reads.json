      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "params": {
          "id": "${res.conversation}"
        },
        "query": {
          "transport": "poll",
          "wait": 1000
        }
      },
      "expect": {
        "status": 200,
        "contract": false
      }
    },
