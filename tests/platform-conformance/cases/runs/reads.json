{
  "schemaVersion": "sdk-conformance-cases/v1",
  "family": "runs",
  "about": "Runs (conversations): reads, events (SSE replay, resume, long-poll) and cross-tenant refusals.",
  "cases": [
    {
      "id": "runs.list.ok",
      "title": "List conversations (runs)",
      "sdk": {
        "family": "runs",
        "method": "list"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "conversations": "array"
        }
      }
    },
    {
      "id": "runs.list.page",
      "title": "A page of one conversation, with a cursor when there are more",
      "sdk": {
        "family": "runs",
        "method": "list"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "query": {
          "limit": 1
        }
      },
      "expect": {
        "status": 200,
        "contract": true
      }
    },
    {
      "id": "runs.get.ok",
      "title": "Get one run with its messages",
      "sdk": {
        "family": "runs",
        "method": "get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations/{id}"
      },
      "tenant": {
        "org": "A",
        "role": "owner"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "params": {
          "id": "${res.conversation}"
        }
      },
      "expect": {
        "status": 200,
        "contract": true,
        "fields": {
          "conversation.id": {
            "equals": "${res.conversation}"
          },
          "messages": "array"
        }
      }
    },
    {
      "id": "runs.get.cross-tenant",
      "title": "Org B's credential on org A's run answers 404, every time",
      "sdk": {
        "family": "runs",
        "method": "get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations/{id}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "params": {
          "id": "${res.conversation}"
        }
      },
      "repeat": 20,
      "expect": {
        "status": 404,
        "errorClass": "NotFoundError",
        "codePresent": true
      }
    },
    {
      "id": "runs.get.forged-scope",
      "title": "Org B's key with org A's scope selectors cannot read org A's run",
      "sdk": {
        "family": "runs",
        "method": "get"
      },
      "op": {
        "method": "GET",
        "path": "/workspace/conversations/{id}"
      },
      "tenant": {
        "org": "B",
        "role": "owner",
        "resourceOrg": "A",
        "scopeOrg": "A"
      },
      "modes": [
        "ee-key",
        "fa-session",
        "fi-keypair"
      ],
      "tags": [
        "deterministic",
        "failure"
      ],
      "needs": [
        "conversation"
      ],
      "call": {
        "params": {
          "id": "${res.conversation}"
        }
      },
      "repeat": 5,
      "expect": {
        "status": [
          401,
          403,
          404
        ]
      },
      "expectByMode": {
        "ee-key": {
          "status": 403,
          "code": "workspace_scope_denied",
          "errorClass": "PermissionDeniedError"
        }
      }
    },
    {
      "id": "runs.list.forged-scope",
      "title": "Org B's key with org A's scope selectors cannot list org A's runs",
      "sdk": {
        "family": "runs",
