        "deterministic",
        "failure"
      ],
      "repeat": 5,
      "expect": {
        "status": [
          401,
          403,
          404
        ]
      },
      "expectByMode": {
        "ee-key": {
          "status": 403,
          "code": "workspace_scope_denied",
          "errorClass": "PermissionDeniedError"
        }
      }
    },
    {
      "id": "runs.get.unknown-id",
      "title": "A run id that does not exist answers 404",
